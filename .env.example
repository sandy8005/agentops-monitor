# AgentOps Monitor — configuration template.
#
#   cp .env.example .env      (then fill in the blanks; .env is git-ignored)
#
# This file is committed and shipped. It must NEVER contain a real value for a
# password, key or secret — scripts/check_release.py fails the release if any
# secret-looking variable here has a value. Every variable settings.py reads is
# listed; commented-out lines show the built-in default.

# --- Database (required) ---
DB_NAME=agentops
DB_USER=agentops
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# DB_CONNECT_TIMEOUT=10
# DB_KEEPALIVES_IDLE=30
# DB_KEEPALIVES_INTERVAL=10
# DB_KEEPALIVES_COUNT=5
# Per-process pool bounds. See README "Connection budget" before scaling workers.
# DB_POOL_MIN=1
# DB_POOL_MAX=20

# --- Environment / sessions ---
# dev | production. In production SESSION_SECRET is REQUIRED; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=dev
SESSION_SECRET=
# SESSION_MAX_AGE=28800
# LOG_LEVEL=INFO

# --- Privacy / retention ---
# REDACT_TRACE_PAYLOADS=true
# TRACE_RETENTION_DAYS=30
# EVAL_UNFLAGGED_SAMPLE_RATE=1.0

# --- Rate limits / uploads ---
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_RUNS=20/minute
# RATE_LIMIT_UPLOAD=10/minute
# Shared limiter storage across API processes, e.g. redis://localhost:6379
# RATE_LIMIT_STORAGE_URI=memory://
# MAX_UPLOAD_BYTES=5242880

# --- LLM (optional: without a key every feature uses the rules-based fallback) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# LLM_QUOTA_COOLDOWN_SECONDS=3600
# Explicit prices in USD per 1M tokens — set BOTH or NEITHER.
# LLM_INPUT_PRICE_PER_MILLION=
# LLM_OUTPUT_PRICE_PER_MILLION=
# LLM_MAX_OUTPUT_TOKENS=8192
# bytes (default: local proven bound, nothing sent before authorization) | provider
# (provider = also call count_tokens, which sends the prompt; authorized + traced)
# LLM_INPUT_TOKEN_BOUND=bytes
# LLM_RESERVE_BYTES_PER_TOKEN=1.0
# LLM_TOKEN_COUNT_MARGIN=0.10
# EXECUTION_HEARTBEAT_GRACE_SECONDS=45

# --- LangGraph checkpoint deserialization hardening ---
# LANGGRAPH_STRICT_MSGPACK=true

# --- Adzuna live-jobs feed (optional; Remotive needs no key) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us